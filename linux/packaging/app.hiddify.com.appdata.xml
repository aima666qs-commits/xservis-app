<?xml version="1.0" encoding="UTF-8"?>
<!-- XFreedom distribution AppStream metadata. Upstream GPL-3.0-or-later licensing is preserved. -->
<component type="desktop-application">
  <id>app.xservis.xfreedom</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>

  <name>XFreedom</name>
  <summary>XFreedom secure network client for Linux</summary>
<description>
    <p>
      XFreedom is a multi-platform secure network client with native tunnel integration,
      subscription import, diagnostics, and reusable premium themes.
    </p>
    <p>
      The distribution preserves the licenses and notices of its upstream open-source components.
    </p>
  </description>
<launchable type="desktop-id">hiddify.desktop</launchable>

  <icon type="stock">hiddify</icon>

  <categories>
    <category>Network</category>
  </categories>

  <keywords>
    <keyword>XFreedom</keyword>
    <keyword>Proxy</keyword>
    <keyword>VPN</keyword>
    <keyword>V2Ray</keyword>
    <keyword>Nekoray</keyword>
    <keyword>Xray</keyword>
    <keyword>Psiphon</keyword>
    <keyword>OpenVPN</keyword>
  </keywords>

  <mime-types>
    <mime-type>x-scheme-handler/xfreedom</mime-type>
    <mime-type>x-scheme-handler/hiddify</mime-type>
    <mime-type>x-scheme-handler/v2ray</mime-type>
    <mime-type>x-scheme-handler/v2rayn</mime-type>
    <mime-type>x-scheme-handler/v2rayng</mime-type>
    <mime-type>x-scheme-handler/clash</mime-type>
    <mime-type>x-scheme-handler/clashmeta</mime-type>
    <mime-type>x-scheme-handler/sing-box</mime-type>
  </mime-types>

  <url type="homepage">https://xservis.app/</url>
  <url type="bugtracker">https://github.com/aima666qs-commits/xservis-app/issues</url>
  <url type="help">https://xservis.app/</url>

  <provides>
    <binary>hiddify</binary>
  </provides>

  <releases>
    <release version="1.0.0" date="2025-10-25">
      <description>
        <p>XFreedom Linux distribution with multi-protocol support and premium theme system.</p>
      </description>
    </release>
  </releases>

  <translation type="gettext">hiddify</translation>

  <custom>
    <value key="PackageName">hiddify</value>
    <value key="Priority">optional</value>
    <value key="Section">x11</value>
    <value key="InstalledSize">6604</value>
    <value key="Essential">false</value>
  </custom>
</component>